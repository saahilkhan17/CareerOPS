# Copy to .env and adjust. Never commit .env.
APP_NAME=careerops
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://careerops:careerops@localhost:5432/careerops
REDIS_URL=redis://localhost:6379/0
# Required in production: HS256 secret for access JWTs. If unset, a random
# per-process secret is generated (tokens die on restart).
AUTH_SECRET_KEY=
# Match scoring weights (normalized by sum) and optional LLM explanation flag.
MATCH_WEIGHT_REQUIRED=0.5
MATCH_WEIGHT_PREFERRED=0.2
MATCH_WEIGHT_EXPERIENCE=0.2
MATCH_WEIGHT_TITLE=0.1
MATCH_LLM_ENABLED=false
# Ingestion: board token -> company display name (Greenhouse responses carry no
# company name); slug -> company (Lever); RemoteOK needs no config (public feed).
INGEST_GREENHOUSE_BOARDS={}
INGEST_LEVER_COMPANIES={}
INGEST_REMOTEOK_ENABLED=true
INGEST_HTTP_RETRIES=3
INGEST_HTTP_BACKOFF=1.0
INGEST_MIN_INTERVAL=1.0
INGEST_AUTOMATCH_LIMIT=500
# Eager Celery execution (tests/dev without a broker).
CELERY_EAGER=false
# Analytics cache TTL (seconds) and per-identity rate limit (requests/minute).
ANALYTICS_CACHE_TTL=300
RATE_LIMIT_PER_MINUTE=120
